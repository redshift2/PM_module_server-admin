<!doctype html><html><head><meta charset="utf-8"><title>Account Connections</title><style>body{font:16px system-ui;background:#1e2328;color:#eef;padding:30px;max-width:800px;margin:auto}a{color:#83c5ff}button{padding:8px 14px}section{background:#303b46;padding:20px;margin:16px 0;border-radius:8px}</style></head><body><h1>Account Connections</h1><p>Connect an external sign-in to your existing Parts Manager account. Your local roles and CAD history stay unchanged.</p><g:if test="${flash.message}"><p>${flash.message?.encodeAsHTML()}</p></g:if><section><h2>Connected identities</h2><g:each in="${links}" var="link"><p>${link.provider?.name?.encodeAsHTML()} (${link.issuer?.encodeAsHTML()}) <form style="display:inline" method="post" action="${request.contextPath}/oidcLogin/unlink"><input type="hidden" name="id" value="${link.id}"/><button type="submit">Disconnect</button></form></p></g:each></section><section><h2>Connect provider</h2><g:each in="${providers}" var="p"><p><a href="${request.contextPath}/oidcLogin/start?id=${p.id}&amp;link=true">Connect ${p.name?.encodeAsHTML()}</a></p></g:each></section><p><a href="${request.contextPath}/">Return to Parts Manager</a></p></body></html>